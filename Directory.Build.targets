<Project>
  <PropertyGroup>
    <BlazoradeStaticPagesGeneratorHost>$(MSBuildThisFileDirectory)src\Blazorade.StaticPages.Generator.Host\bin\$(Configuration)\net10.0\Blazorade.StaticPages.Generator.Host.dll</BlazoradeStaticPagesGeneratorHost>
    <BlazoradeStaticPagesGeneratedOutput>$(IntermediateOutputPath)Blazorade.StaticPages\generated</BlazoradeStaticPagesGeneratedOutput>
  </PropertyGroup>

  <Target Name="BuildBlazoradeStaticPagesGenerator" BeforeTargets="GenerateBlazoradeStaticPages" Condition="'$(MSBuildProjectName)' != 'Blazorade.StaticPages' and '$(MSBuildProjectName)' != 'Blazorade.StaticPages.Generator.Host' and '$(MSBuildProjectName)' != 'Blazorade.StaticPages.Generator' and Exists('$(MSBuildThisFileDirectory)src\Blazorade.StaticPages.Generator.Host\Blazorade.StaticPages.Generator.Host.csproj')">
    <MSBuild Projects="$(MSBuildThisFileDirectory)src\Blazorade.StaticPages.Generator.Host\Blazorade.StaticPages.Generator.Host.csproj" Properties="Configuration=$(Configuration)" />
  </Target>

  <Target Name="GenerateBlazoradeStaticPages" AfterTargets="Build" Condition="Exists('$(TargetPath)') and '$(MSBuildProjectName)' != 'Blazorade.StaticPages.Generator.Host' and '$(MSBuildProjectName)' != 'Blazorade.StaticPages.Generator' and '$(MSBuildProjectName)' != 'Blazorade.StaticPages'">
    <RemoveDir Directories="$(BlazoradeStaticPagesGeneratedOutput)" />
    <Warning Text="No Blazorade Static Pages configuration file was found. Configuration-dependent metadata will be omitted from generated static pages." Condition="!Exists('$(MSBuildProjectDirectory)\blazorade.config.json') and !Exists('$(MSBuildProjectDirectory)\blazorade.config.$(Configuration).json')" />
    <Exec Command="dotnet &quot;$(BlazoradeStaticPagesGeneratorHost)&quot; &quot;$(TargetPath)&quot; &quot;$(BlazoradeStaticPagesGeneratedOutput)&quot; &quot;$(MSBuildProjectDirectory)&quot; &quot;&quot; &quot;$(Configuration)&quot;" />
    <ItemGroup>
      <BlazoradeStaticPagesGeneratedFile Include="$(BlazoradeStaticPagesGeneratedOutput)\**\*" />
    </ItemGroup>
    <MakeDir Directories="$(TargetDir)wwwroot" />
    <Copy
      SourceFiles="@(BlazoradeStaticPagesGeneratedFile)"
      DestinationFiles="@(BlazoradeStaticPagesGeneratedFile->'$(TargetDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyBlazoradeStaticPagesToPublish" AfterTargets="Publish" Condition="Exists('$(BlazoradeStaticPagesGeneratedOutput)') and '$(MSBuildProjectName)' != 'Blazorade.StaticPages.Generator.Host' and '$(MSBuildProjectName)' != 'Blazorade.StaticPages.Generator' and '$(MSBuildProjectName)' != 'Blazorade.StaticPages'">
    <ItemGroup>
      <BlazoradeStaticPagesGeneratedFile Include="$(BlazoradeStaticPagesGeneratedOutput)\**\*" />
      <BlazoradeStaticPagesPublishedBootstrapper Include="$(PublishDir)wwwroot\_framework\blazor.webassembly.*.js" />
      <BlazoradeStaticPagesPublishedDotnetBootstrapper Include="$(PublishDir)wwwroot\_framework\dotnet.??????????.js" />
    </ItemGroup>
    <Copy
      SourceFiles="@(BlazoradeStaticPagesGeneratedFile)"
      DestinationFiles="@(BlazoradeStaticPagesGeneratedFile->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="@(BlazoradeStaticPagesPublishedBootstrapper)"
      DestinationFiles="$(PublishDir)wwwroot\_framework\blazor.webassembly.js"
      SkipUnchangedFiles="true"
      Condition="@(BlazoradeStaticPagesPublishedBootstrapper->Count()) == '1'" />
    <Copy
      SourceFiles="@(BlazoradeStaticPagesPublishedDotnetBootstrapper)"
      DestinationFiles="$(PublishDir)wwwroot\_framework\dotnet.js"
      SkipUnchangedFiles="true"
      Condition="@(BlazoradeStaticPagesPublishedDotnetBootstrapper->Count()) == '1'" />
  </Target>

</Project>