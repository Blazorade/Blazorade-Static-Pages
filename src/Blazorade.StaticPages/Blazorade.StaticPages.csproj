<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<PackageId>Blazorade.StaticPages</PackageId>
		<Version>1.0.0-preview.6</Version>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Copyright>Copyright (c) Mika Berglund 2026</Copyright>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/Blazorade/Blazorade-Static-Pages</RepositoryUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<DocumentationFile>Blazorade.StaticPages.xml</DocumentationFile>
	</PropertyGroup>


	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Blazorade.Core" Version="4.0.0" />
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.8" />
	</ItemGroup>

	<ItemGroup>
		<None Include="buildTransitive\Blazorade.StaticPages.targets" Pack="true" PackagePath="buildTransitive\" />
		<None Include="..\Blazorade.StaticPages.Generator.Host\bin\$(Configuration)\net10.0\**\*" Pack="true" PackagePath="tools\net10.0\" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="README.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

</Project>
