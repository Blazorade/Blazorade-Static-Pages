<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Blazorade.StaticPages</PackageId>
  </PropertyGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Blazorade.Core" Version="4.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <None Include="buildTransitive\Blazorade.StaticPages.targets" Pack="true" PackagePath="buildTransitive\" />
    <None Include="..\Blazorade.StaticPages.Generator.Host\bin\$(Configuration)\net10.0\**\*" Pack="true" PackagePath="tools\net10.0\" />
  </ItemGroup>

</Project>
