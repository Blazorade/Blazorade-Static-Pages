@page "/my-first-post"

@code {
    string title = "My First Post";
    string description = "This is the description of my first post in Blazorade Static Pages.";
}

@attribute [StaticPage]

<StaticMetadata Title="@title" Description="@description" />

<StaticContent>
    <main>
        <article>
            <h1>@title</h1>

            <p>@description</p>
        </article>
    </main>
</StaticContent>
