@page "/articles/my-first-article"

@code {
    string title = "My First Article";
    string description = "This is the description of my first article in Blazorade Static Pages.";
}

@attribute [StaticPage]

<StaticMetadata Title="@title" Description="@description" />

<StaticContent>
    <main>
        <article>
            <h1>@title</h1>

            <p>@description</p>
        </article>
    </main>
</StaticContent>
